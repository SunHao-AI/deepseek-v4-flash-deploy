# ============================================================
# DeepSeek-V4-Flash 服务配置模板
#
# 使用方法：复制为 .env 并修改
#   cp .env.example .env
#
# 配置优先级：命令行参数 > 环境变量 > .env > 脚本内置默认值
# 值含空格或特殊字符时用双引号包裹，例如 FOO="a b c"
# ============================================================

# ---------- 模型路径 ----------
# GGUF 模型第一个分片（必填；部署时请改为实际绝对路径）
MODEL=/raid5/sh/model-gguf/DeepSeek-V4-Flash-0731-GGUF/UD-Q8_K_XL/DeepSeek-V4-Flash-0731-UD-Q8_K_XL-00001-of-00005.gguf
# DSpark 草稿模型；留空则自动在模型目录及上级目录查找 dspark*.gguf
DRAFT=

# ---------- 下载配置（--download 时使用） ----------
# ModelScope GGUF 仓库 ID
MODELSCOPE_ID=unsloth/DeepSeek-V4-Flash-0731-GGUF
# 要下载的量化版本目录名（UD-Q8_K_XL 无损 / UD-Q4_K_XL 近无损）
QUANT=UD-Q8_K_XL
# GGUF 保存父目录（绝对路径）
MODEL_ROOT=/raid5/sh/model-gguf

# ---------- 服务配置 ----------
# 服务端口
PORT=18888
# 上下文长度（总 ctx）。留空时由脚本自动计算：PARALLEL × 1048576
# （每个并发槽位 1M 上下文）；如需手动指定，取消注释并填值。
#CTX_SIZE=1048576
# 并发序列数（官方版并行若崩溃可改 1）
PARALLEL=2
# GPU 数量（多卡 split-mode layer）
GPU_COUNT=8
# API 密钥；留空则不校验
API_KEY=root123456

# ---------- 推理 / 投机解码 ----------
# 思考模式 on/off
REASONING=on
# 推理内容输出格式
REASONING_FORMAT=deepseek
# DSpark 投机解码开关 on/off
DSPARK=on
# 投机解码类型
SPEC_TYPE=draft-dspark
# DSpark 最大草稿 token 数（Unsloth 推荐 3，更大反而更慢）
SPEC_DRAFT_N_MAX=3
# 草稿模型 GPU 层数
N_GPU_LAYERS_DRAFT=999

# ---------- KV cache 量化 ----------
# K/V 量化类型（q8_0 已在官方 b10298 验证正常；f16 更保守；留空回退 f16）
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# ---------- 其他 ----------
# 官方 llama.cpp 源码目录（绝对路径）
SOURCE_DIR=/raid5/sh/code/llama.cpp
# --fit 模式（DSpark README 推荐 off；on 时草稿显存预留会被跳过）
FIT=off
# 服务器日志目录（绝对路径）
LOG_DIR=/raid5/sh/logs

# ---------- cc-switch 用量统计服务（usage_stats_server.py） ----------
# 监听地址；统计服务与 llama-server 同机部署时建议留空，由 nginx 所在机器访问时设 0.0.0.0
USAGE_HOST=0.0.0.0
# 统计服务监听端口（注意：5001 已被 nginx location / 占用，勿改）
USAGE_PORT=5002
# llama-server 地址（/metrics 数据源）；统计服务与 llama-server 同机时可用 http://127.0.0.1:18888
USAGE_LLAMA_BASE=http://192.168.77.210:18888
# 数据获取模式：poll=后台定时轮询（默认）；on-demand=由 cc-switch 轮询触发、每次请求同步拉取最新指标
USAGE_MODE=poll
# 轮询间隔（秒）；仅 poll 模式生效
USAGE_POLL_INTERVAL=5
# DeepSeek-V4-Flash 官方价（元/M tokens；官方调价后在此更新）
USAGE_PRICE_IN=1.0
USAGE_PRICE_OUT=2.0
# 预算（元）；留空则不显示 total/remaining，仅显示已用费用
#USAGE_BUDGET=100
# llama-server /metrics 若要求鉴权，填 API 密钥（Bearer 透传）；留空则默认复用上方 API_KEY，通常无需设置
#LLAMA_API_KEY=root123456
